PAPER_MODE=true
DB_PATH=data/bot.db
STARTING_BANKROLL=100.0

# Strategy Thresholds
EDGE_THRESHOLD=0.08
MIN_MODEL_AGREEMENT=0.75
# Maximum ensemble disagreement before a trade is skipped, as a WEIGHTED STANDARD
# DEVIATION in °F. Renamed from MAX_MODEL_SPREAD (2.7 = 1.5°C of max-min range)
# on 2026-07-31 because the statistic changed; 2.7 as a standard deviation is
# ~6.9°F of range and would disable the gate entirely.
MAX_MODEL_SPREAD_STD=1.05

# INTERCEPT of |error| = a + b*weighted_spread_std, in °F, by lead time
# (interpolated). NOT a standalone sigma since 2026-07-31 — it is scaled per
# direction by SIGMA_SCALE_HIGH / SIGMA_SCALE_LOW downstream. The old
# sigma-valued ramp (1.0/1.5/2.0/2.5) parses fine and silently inflates every
# forecast's uncertainty; config.validate_env_ranges() rejects it at boot.
BASE_FORECAST_ERROR_12H=0.84
BASE_FORECAST_ERROR_24H=0.84
BASE_FORECAST_ERROR_48H=0.84
BASE_FORECAST_ERROR_72H=0.95

# Risk / Sizing (Micro-account)
DAILY_LOSS_LIMIT=-5.00
HARD_MAX_POSITION_SIZE=2.0
MAX_POSITION_FRACTION=0.10
MAX_TOTAL_EXPOSURE_FRACTION=0.30
MAX_CONCURRENT_POSITIONS=3
BASE_POSITION_FRACTION=0.05
KELLY_CAP=0.08
MIN_POSITION_SIZE=0.50

STOP_LOSS_PCT=0.15
EXIT_EDGE_FLOOR=0.05

# Market Filters
MIN_VOLUME=10000
MAX_HOURS_TO_RESOLUTION=72

# Market Discovery
# Markets per API page (Gamma API max is 100)
MARKET_DISCOVERY_LIMIT=100
# Maximum pages to fetch per scan cycle (100 markets each)
MARKET_DISCOVERY_MAX_PAGES=10
# Stop fetching new pages once this many weather candidates are found
MARKET_DISCOVERY_STOP_AFTER_WEATHER=50

# Debugging
# Show accepted weather markets detail
DEBUG_MARKET_SCAN=false
# Show all skipped markets detail (verbose)
DEBUG_MARKET_SCAN_VERBOSE=false
# Print discovered weather markets and exit without trading (useful for manual checks)
DEBUG_WEATHER_DISCOVERY=false

# Scheduling (minutes)
SCAN_INTERVAL_MINUTES=10
MONITOR_INTERVAL_MINUTES=5

# --- Independent forecast veto gate ---
# A second opinion from OUTSIDE the Open-Meteo ensemble, used only to REFUSE
# trades — never to adjust a probability. It catches the blunders that live
# upstream of the probability calculation and are invisible to it: wrong
# station, stale model run, misparsed bucket, correlated-ensemble collapse.
#
# ARMED BY DEFAULT (owner decision 2026-08-05, no shadow period). Leaving this
# false is flagged at boot by validate_env_ranges().
INDEPENDENT_VETO_ENABLED=true
# ~2x the measured MAE of 2.59F. Loose BY DESIGN: sized to catch a wrong station
# or a stale run, not a marginal forecast difference. Measured fire rate on the
# 11 NWS cities before deploy: 10.3% (n=58). Do not tighten without evidence.
DISAGREEMENT_VETO_F=5.0
# Half-width of the band in which the outcome being bet against counts as live.
# COUPLED TO FORECAST_MARGIN_F (2.5) — only 0.5F wider. Re-measure before moving
# either; see reports/independent-veto-2026-08-06.md section 4c.
PLAUSIBLE_BAND_F=2.0
# 6h. 51 cities x 3 refreshes/day stays inside DataHub's 360/day free tier.
INDEPENDENT_CACHE_TTL_SECONDS=21600
# Short on purpose: this runs inside trade evaluation for a signal that is
# allowed to be missing. Answer fast or don't answer.
INDEPENDENT_TIMEOUT_SECONDS=3.0
# Auto-disable tripwire over a rolling 24h window. Stands in for the shadow
# period the owner decision skipped — do not raise it to 1.0 (which can never
# fire) without replacing the mitigation.
INDEPENDENT_VETO_MAX_FIRE_RATE=0.25
INDEPENDENT_VETO_MIN_SAMPLE=20
INDEPENDENT_VETO_CITY_CONCENTRATION=0.50
INDEPENDENT_BREAKER_FAILURES=5
INDEPENDENT_BREAKER_COOLDOWN_SECONDS=3600
# api.weather.gov REQUIRES a User-Agent naming the application and a contact
# address, and rejects requests without one.
INDEPENDENT_USER_AGENT=stormedge-weather-bot (frederickrowley7@gmail.com)
# UK Met Office DataHub key for the 40 non-US cities (free plan, 360 calls/day,
# register at datahub.metoffice.gov.uk). WITHOUT IT those cities resolve to
# INCONCLUSIVE and never veto — 11 of 51 cities are gated. Absent is not zero:
# an unset key can never be misread as "UKMO covers nothing there".
METOFFICE_DATAHUB_KEY=

# --- Off-box backup ---
# The trade ledger, the resolutions every constant is fitted against, and the
# replay log all live in ONE file on ONE Fly volume, and none of it can be
# rebuilt from Polymarket or Open-Meteo. A daily snapshot runs at 02:30 UTC
# (before the 03:00 purge+vacuum) regardless of the settings below; what these
# control is whether it leaves the machine.
#
# Any endpoint that accepts an authenticated PUT: an R2/B2/S3 presigned URL, or
# your own. `{name}` is replaced with the snapshot filename. Leave blank and the
# dashboard will report the gap rather than pretending it is covered — in that
# case pull GET /api/backup/latest on a schedule instead (authenticated; a cron
# on a laptop holding a session cookie is a perfectly good off-box destination).
BACKUP_PUT_URL_TEMPLATE=
# Optional, for destinations wanting a header instead of a presigned query
# string. Format "Header-Name: value", e.g. "Authorization: Bearer xxx".
BACKUP_PUT_AUTH_HEADER=
BACKUP_KEEP_LOCAL=3
BACKUP_MAX_AGE_HOURS=36

# Polymarket credentials (only needed for live trading)
POLYMARKET_PK=your_private_key_here
CLOB_API_KEY=your_clob_api_key
CLOB_SECRET=your_clob_secret
CLOB_PASS_PHRASE=your_clob_passphrase

# Wallet type. 0 = raw EOA (the signer funds directly). 1/2/3 = proxy or
# deposit wallet, where funds sit at an address DIFFERENT from the signer —
# a POLY_1271 deposit wallet is 3. Getting this wrong is invisible to reads
# and only shows up as rejected orders, so preflight's `funder` check blocks
# on it: with a non-zero SIG_TYPE, FUNDER must be set and must NOT equal the
# signer address. Copy it from Profile -> "Your Polymarket Wallet Address".
POLYMARKET_SIG_TYPE=0
POLYMARKET_FUNDER=

