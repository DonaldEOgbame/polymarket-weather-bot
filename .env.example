PAPER_MODE=true
PAUSE_SCANNING=false
DB_PATH=data/bot.db
STARTING_BANKROLL=40.0

# --- Strategy & Entry Gates ---
# Fixed stake in USDC. The single authority on position size. Set to 0 to use fractional Kelly.
FIXED_POSITION_SIZE=3.0
# Dynamic daily circuit breaker budget in full stakes (limit = -(effective_stake * DAILY_LOSS_STAKES))
DAILY_LOSS_STAKES=4
MAX_CONCURRENT_POSITIONS=4
MAX_TOTAL_EXPOSURE_FRACTION=0.70
MAX_TRADES_PER_DAY=15

# Market Kind Selection
TRADE_LOW_MARKETS=true
TRADE_HIGH_MARKETS=false

# Forecast Clearance & Price Sweet Spot
FORECAST_MARGIN_F=2.5
MIN_ENTRY_PRICE=0.70
MAX_ENTRY_PRICE=0.77
MAX_HOURS_TO_RESOLUTION=48.0
REQUIRE_SAME_DAY=false
ONE_TRADE_PER_CITY_DATE=true

# Execution & Liquidity Guards
MIN_DEPTH_MULTIPLE=10.0
REQUIRE_DEPTH_TO_TRADE=true
MAX_ENTRY_SPREAD_FRACTION=0.15
TAKER_FEE_RATE=0.05
SLIPPAGE_FRACTION=0.015
USE_MARKETABLE_LIMIT=true
MAX_SUBMIT_DRIFT=0.02

# Position Monitoring & Exits
# Hold-to-resolution default: standard price stops are disabled to avoid cutting winners on intraday volatility
ENABLE_STOP_LOSS=false
STOP_LOSS_PCT=0.50
TAKE_PROFIT_PRICE=0.98
ENABLE_PHYSICS_EXIT_GATE=true
ENABLE_POST_DATE_SALVAGE=true

# Correlated Risk Controls
ENABLE_CORRELATION_LIMITS=true
MAX_GROUP_STAKES_PER_DATE=3
MAX_DIRECTION_STAKES_PER_DATE=6

# --- Meteorological Uncertainty & Calibration ---
EDGE_THRESHOLD=0.00
MIN_MODEL_AGREEMENT=0.75
MAX_MODEL_SPREAD_STD=1.05
ENABLE_FAMILY_WEIGHTING=true
FAMILY_WEIGHT_CAP=0.35
ENABLE_PROB_CALIBRATION=true
PROB_CALIBRATION_INTERCEPT=0.8000
PROB_CALIBRATION_SLOPE=0.7480
MIN_BUCKET_PROB=0.05
NARROW_BUCKET_STD_INFLATION=1.1
CONVECTIVE_STD_INFLATION=1.3
SIGMA_SPREAD_COEF=2.78
SIGMA_SCALE_HIGH=1.02
SIGMA_SCALE_LOW=0.80
MIN_SIGMA_F=1.0
MAX_SIGMA_F=8.0
SIGMA_STUDENT_T_DF=4

# Base error intercept by lead time (interpolated)
BASE_FORECAST_ERROR_12H=0.84
BASE_FORECAST_ERROR_24H=0.84
BASE_FORECAST_ERROR_48H=0.84
BASE_FORECAST_ERROR_72H=0.95

# --- Market Discovery ---
MIN_VOLUME=500
MARKET_DISCOVERY_LIMIT=100
MARKET_DISCOVERY_MAX_PAGES=20
MAX_CLOB_CANDIDATES=1200

# --- Dashboard & Authentication ---
DASHBOARD_EMAIL=donaldemmaogbame@gmail.com
DASHBOARD_PASSWORD=stormedge

# --- Scheduling (minutes) ---
SCAN_INTERVAL_MINUTES=10
MONITOR_INTERVAL_MINUTES=5

# --- Off-box Backup (Optional) ---
# Endpoint accepting authenticated PUT requests for SQLite database snapshots
BACKUP_PUT_URL_TEMPLATE=
BACKUP_PUT_AUTH_HEADER=
BACKUP_KEEP_LOCAL=3
BACKUP_MAX_AGE_HOURS=36

# --- Polymarket Credentials (Required for Live Trading) ---
POLYMARKET_PK=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
# Wallet type: 0 = raw EOA, 1/2/3 = proxy or deposit wallet
POLYMARKET_SIG_TYPE=0
# Required if POLYMARKET_SIG_TYPE != 0
POLYMARKET_FUNDER=
